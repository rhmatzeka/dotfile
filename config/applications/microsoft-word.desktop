[Desktop Entry]
Type=Application
Name=Microsoft Word (web)
Comment=Microsoft Word in its own window (Microsoft 365 web app; sign in with your Microsoft account)
Exec=sh -c "if [ \\$# -gt 0 ]; then exec ~/.local/bin/m365-open \\"\\$@\\"; else exec ~/.local/bin/m365 word; fi" sh %F
Icon=x-office-document
Terminal=false
Categories=Office;WordProcessor;
StartupWMClass=m365-word
