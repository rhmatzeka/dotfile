index 25c50447..0e31dc17 100644
--- a/modules/nexus/pages/bluetooth/BluetoothPairing.qml
+++ b/modules/nexus/pages/bluetooth/BluetoothPairing.qml
@@ -17,6 +17,40 @@ PageBase {
 
     readonly property BluetoothAdapter adapter: Bluetooth.defaultAdapter // qmllint disable unresolved-type
 
+    // Devices that do not broadcast a name only show their MAC address (anonymous phones, trackers, TVs nearby).
+    // Hide those unless they are being paired, and show the device type instead of the address.
+    readonly property var unpaired: Bluetooth.devices.values.filter(d => !d.bonded) // qmllint disable unresolved-type
+    readonly property var named: unpaired.filter(d => d.pairing || !isUnnamed(d))
+    readonly property int hiddenCount: unpaired.length - named.length
+
+    function isUnnamed(d): bool {
+        const n = d.name ?? "";
+        return !n || /^([0-9A-Fa-f]{2}[-:]){5}[0-9A-Fa-f]{2}$/.test(n);
+    }
+
+    function deviceType(icon: string): string {
+        const i = icon ?? "";
+        if (i.includes("headset") || i.includes("headphones"))
+            return Tr.tr("Headphones");
+        if (i.includes("audio"))
+            return Tr.tr("Speaker");
+        if (i.includes("phone"))
+            return Tr.tr("Phone");
+        if (i.includes("computer"))
+            return Tr.tr("Computer");
+        if (i.includes("mouse"))
+            return Tr.tr("Mouse");
+        if (i.includes("keyboard"))
+            return Tr.tr("Keyboard");
+        if (i.includes("gaming"))
+            return Tr.tr("Game controller");
+        if (i.includes("video") || i.includes("display"))
+            return Tr.tr("TV / display");
+        if (i.includes("printer"))
+            return Tr.tr("Printer");
+        return Tr.tr("Bluetooth device");
+    }
+
     function setScan(on: bool): void {
         if (adapter?.enabled)
             adapter.discovering = on;
