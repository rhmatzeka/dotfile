diff --git a/components/StyledText.qml b/components/StyledText.qml
index e39e72e7..0edfeb56 100644
--- a/components/StyledText.qml
+++ b/components/StyledText.qml
@@ -14,6 +14,12 @@ Text {
     color: Colours.palette.m3onSurface
     font: Tokens.font.body.small
 
+    // Transparent panels: text that sits straight on the see-through surface gets a thin halo in the
+    // opposite tone, so it stays readable on bright or dark wallpapers. Text on solid containers is left alone.
+    readonly property bool needsHalo: Colours.transparency.enabled && (Colours.light ? color.hslLightness < 0.5 : color.hslLightness >= 0.5)
+    style: needsHalo ? Text.Outline : Text.Normal
+    styleColor: Colours.light ? Qt.rgba(1, 1, 1, 0.45) : Qt.rgba(0, 0, 0, 0.45)
+
     Behavior on color {
         CAnim {}
     }
