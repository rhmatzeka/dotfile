@@ -168,8 +172,19 @@ TextFieldBase {
 
             sourceComponent: MaterialIcon {
                 text: root.trailingIcon
-                color: Colours.palette.m3onSurfaceVariant
+                color: root.revealable && eyeArea.containsMouse ? Colours.palette.m3onSurface : Colours.palette.m3onSurfaceVariant
                 fontStyle: Tokens.font.icon.builders.medium.scale(0.9).build()
+
+                MouseArea {
+                    id: eyeArea
+
+                    anchors.fill: parent
+                    anchors.margins: -Tokens.padding.small
+                    enabled: root.revealable
+                    hoverEnabled: true
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: root.revealed = !root.revealed
+                }
             }
         }
     }
