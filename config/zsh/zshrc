# ~/.zshrc  (managed by rhmatzeka/dotfile: edit ~/.dotfiles/config/zsh/zshrc, or put local tweaks in ~/.zshrc.local)

# ── PATH ─────────────────────────────────────────────────────────────────────
typeset -U path                                   # no duplicates
path=("$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.bun/bin" $path)

export EDITOR=nvim
export VISUAL=nvim

# ── history ──────────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS SHARE_HISTORY EXTENDED_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS

# ── Oh My Zsh (skipped quietly if it is not installed) ────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                                      # the prompt comes from starship below
plugins=(git)
[[ -d $ZSH/custom/plugins/zsh-autosuggestions ]]     && plugins+=(zsh-autosuggestions)
[[ -d $ZSH/custom/plugins/zsh-syntax-highlighting ]] && plugins+=(zsh-syntax-highlighting)

# syntax colours (Dracula palette with a cyan accent); must be set before the plugin loads
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#00d9ff,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#bd93f9,bold'
ZSH_HIGHLIGHT_STYLES[function]='fg=#00d9ff,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#8be9fd,bold'
ZSH_HIGHLIGHT_STYLES[path]='fg=#ffb86c'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ff5555'

[[ -r $ZSH/oh-my-zsh.sh ]] && source "$ZSH/oh-my-zsh.sh"

# ── tools, each one optional ─────────────────────────────────────────────────
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lh --group-directories-first --icons=auto --git'
  alias la='eza -lah --group-directories-first --icons=auto --git'
else
  alias ll='ls -lh'; alias la='ls -lAh'
fi
alias n='nvim'
alias ..='cd ..'
alias ...='cd ../..'

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# fzf key bindings: Ctrl-R history, Ctrl-T files, Alt-C directories
for f in /usr/share/doc/fzf/examples/key-bindings.zsh /usr/share/fzf/key-bindings.zsh; do
  [[ -r $f ]] && { source "$f"; break; }
done

# ── prompt ───────────────────────────────────────────────────────────────────
if command -v starship >/dev/null 2>&1; then
  export STARSHIP_CONFIG="$HOME/.config/starship.toml"
  eval "$(starship init zsh)"
fi

# ── machine-local overrides (not in the repo) ─────────────────────────────────
[[ -r $HOME/.zshrc.local ]] && source "$HOME/.zshrc.local"
